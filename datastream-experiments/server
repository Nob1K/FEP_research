#!/usr/bin/env python3
import socketserver,threading,datetime,socket,select,time,os,argparse,string
parser = argparse.ArgumentParser()
parser.add_argument('-p','--send-size',dest='size',action='store',type=int,default=1)
parser.add_argument('--mode', dest='mode', type=int, required=True)
args,unknown = parser.parse_known_args()
bindPort = 31004

def recv_exact(sock, n):
    data = b''
    while len(data) < n:
        chunk = sock.recv(n - len(data))
        if not chunk:
            raise ConnectionError("Socket closed before all bytes received")
        data += chunk
    return data

def timestamp():
    return datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S.%f')

with open('server.txt','w') as f:
    pass
class handler(socketserver.BaseRequestHandler):
    def handle(self):
        sock = self.request
        if args.mode in [3, 4]:
            # server send first byte
            sock.send(b'X' * args.size)
            with open('server.txt', 'a') as f:
                f.write(f"time: {timestamp()}, sent {args.size} byte of X\n")
                f.flush()
            if args.mode == 4:
                # mode 4 server sends another byte
                time.sleep(1)
                sock.send(b'Y' * args.size)
                with open('server.txt', 'a') as f:
                    f.write(f"time: {timestamp()}, sent {args.size} byte of Y\n")
                    f.flush()
        rec = 0
        while True:
            try:
                dat = recv_exact(sock, args.size)
                if not dat:
                    return
                rec += 1
                with open('server.txt', 'a') as f:
                    f.write(f"time: {timestamp()}, recv {len(dat)} bytes, last byte content: {dat[-1]}\n")
                    f.flush()
            except:
                return

            # mode 2: send one byte after receiving one from client
            if args.mode == 2 and dat:
                time.sleep(1)
                sock.send(b'Y' * args.size)
                with open('server.txt', 'a') as f:
                    f.write(f"time: {timestamp()}, sent {args.size} byte of Y\n")
                    f.flush()
            
            if args.mode ==3 and rec >= 1:
                break
            
            if args.mode == 1 and rec >= 2:
                break

                
if __name__ == '__main__':
    host,port = '127.0.0.1',bindPort
    socketserver.ThreadingTCPServer.allow_reuse_address = True
    with socketserver.ThreadingTCPServer((host,port),handler) as server:

        server.serve_forever()
