#!/usr/bin/env python3
import socketserver,threading,datetime,socket,select,time,os,argparse,string
parser = argparse.ArgumentParser()
parser.add_argument('-p','--send-size',dest='size',action='store',type=int,default=1)
parser.add_argument('--mode', dest='mode', type=int, required=True)
parser.add_argument('--num-messages', dest='nm', action='store', type=int, default=1)
args,unknown = parser.parse_known_args()
bindPort = 31004

def recv_exact(sock, n):
    data = b''
    while len(data) < n:
        chunk = sock.recv(n - len(data))
        if not chunk:
            raise ConnectionError("Socket closed before all bytes received")
        data += chunk
    return data

def timestamp():
    return datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S.%f')

def log(msg):
    with open('server.txt', 'a') as f:
        f.write(f"time: {timestamp()}, {msg}\n")
        f.flush()
    print(msg)

with open('server.txt','w') as f:
    pass

class handler(socketserver.BaseRequestHandler):
    def handle(self):
        sock = self.request
        if args.mode in [3, 4]:
            # server send first msg
            for i in range(args.nm):
                log(f"Iteration: {i+1}")
                sock.send(b'X' * args.size)
                log(f"sent {args.size} byte of X")
                if args.mode == 4:
                    # mode 4 server sends another msg
                    time.sleep(0.5)
                    sock.send(b'Y' * args.size)
                    log(f"sent {args.size} byte of Y")
                time.sleep(0.5)
        rec = 0
        while args.mode in [1, 2, 3]:
            try:
                dat = recv_exact(sock, args.size)
                if not dat:
                    return
                rec += 1
                log(f"recv {len(dat)} bytes, last byte content: {dat[-1]}")
                time.sleep(0.5)
            except:
                return

            # mode 2: send one byte after receiving one from client
            if args.mode == 2 and rec == args.nm:
                for i in range(args.nm):
                    sock.send(b'Y' * args.size)
                    log(f"sent {args.size} byte of Y")
                    time.sleep(0.5)
            
            if args.mode == 3 and rec >= args.nm:
                break
            
            if args.mode == 1 and rec >= (args.nm * 2):
                break
            
            

                
if __name__ == '__main__':
    host,port = '127.0.0.1',bindPort
    socketserver.ThreadingTCPServer.allow_reuse_address = True
    with socketserver.ThreadingTCPServer((host,port),handler) as server:

        server.serve_forever()
