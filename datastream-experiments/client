#!/usr/bin/env python3
import socket, argparse, datetime
parser = argparse.ArgumentParser()
parser.add_argument('-p','--send-size',dest='size',action='store',type=int,default=1)
parser.add_argument('--mode', dest='mode', type=int, required=True, help="Test mode: 1-4")
parser.add_argument('--socks', action='store_true', help="use socks5 proxy")
parser.add_argument('--no-socks', dest='socks', action='store_false', help="disable socks5 proxy")
parser.set_defaults(socks=True)
args,unknown = parser.parse_known_args()
clientPort = 31000
#this is the client MITM
serverPort = 31003
#this is the final server MITM that's targeted in the SOCKS request

def recv_exact(sock, n):
    data = b''
    while len(data) < n:
        chunk = sock.recv(n - len(data))
        if not chunk:
            raise ConnectionError("Socket closed before all bytes received")
        data += chunk
    return data


def open_connection(socks=False):
    proxy_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    proxy_socket.connect(('127.0.0.1', clientPort))
    
    # socks5 handshake manually done
    if socks:
        # 5,1,0 initialization packet - 5:socks5, 1: one auth method supported, 0: no auth
        proxy_socket.send(b'\x05\x01\x00')
        method_reply = recv_exact(proxy_socket, 2)
        # 5,1,0,1 - 5:socks5, 1: tcp/ip, 0:reserved, 1: address type is ipv4
        proxy_socket.send(b'\x05\x01\x00\x01')
        # host dest - 127.0.0.1
        proxy_socket.send(b'\x7f\x00\x00\x01')
        # host port - 2 bytes, big endian(network byte order =)
        proxy_socket.send((serverPort).to_bytes(2,'big'))
        conn_reply = recv_exact(proxy_socket, 10)
    return proxy_socket

with open('client.txt', 'w') as f:
    pass

def log(msg):
    with open('client.txt', 'a') as f:
        current_time = datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S.%f')
        f.write(f"time: {current_time}, {msg}\n")
    print(msg)
       
#if socks5 proxy
conn = open_connection(socks=args.socks)
#else
import time
count = 0
conn.settimeout(10)

log(f"Mode {args.mode} - start experiment")

if args.mode == 1:
    # client sends 1 byte at t=1, then another at t=2
    conn.send(b'A' * args.size)
    log(f"Sent {args.size} byte of A")
    time.sleep(1)
    conn.send(b'B' * args.size)
    log(f"Sent {args.size} byte of B")

elif args.mode == 2:
    # client sends 1 byte, waits for server to send 1 byte
    conn.send(b'A' * args.size)
    log(f"Sent {args.size} byte of A")
    try:
        data = conn.recv(args.size)
        if data:
            log(f"Received {len(data)} bytes, last byte content: {data[-1]!r}")
    except socket.timeout:
        log("Receive timeout")

elif args.mode == 3:
    # receive 1 byte from server, then send a byte
    try:
        data = conn.recv(args.size)
        log(f"Received {args.size} bytes, last byte content: {data[-1]!r}")
    except socket.timeout:
        log("Receive timeout waiting for server")
    time.sleep(1)
    conn.send(b'B' * args.size)
    log(f"Sent {args.size} byte of B")

elif args.mode == 4:
    # receive two one-byte msg (t=1 and t=2)
    try:
        data1 = conn.recv(args.size)
        log(f"Received 1st {args.size} bytes, last byte content: {data1[-1]!r}")
    except socket.timeout:
        log("Timeout on 1st bytes")
    time.sleep(0.5)
    try:
        data2 = conn.recv(args.size)
        log(f"Received 2nd {args.size} bytes, last byte content: {data2[-1]!r}")
    except socket.timeout:
        log("Timeout on 2nd bytes")

conn.close()
log("Connection closed")